---
import Base from '../layouts/Base.astro';
import { CHAPTERS, REPO, romanNumeral } from '../chapters';
---

<Base
  title="Principles — a collaborative project for approaching obstacles"
  description="Guiding principles, practical strategies, and the stories behind them — a living, forkable book about approaching life's obstacles."
>
  <div class="wrap-prose">
    <section class="hero">
      <h1>Principles</h1>
      <p class="tagline">
        A collaborative project for approaching obstacles — guiding principles,
        practical strategies, and the stories of how I got to them.
      </p>
    </section>

    <ol class="toc">
      {
        CHAPTERS.map((chapter, i) => (
          <li>
            <a href={`/${chapter.id}/`}>
              <span class="numeral">{romanNumeral(i + 1)}</span>
              <span class="chapter-title">{chapter.title}</span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="colophon">
      Inspired by Ray Dalio’s <em>Principles</em> — fork them, don’t follow them.
      Contribute by <a href="mailto:toli@tolicodes.com">email</a>, <a href={`${REPO}/issues`}>issue</a>,
      or <a href={`${REPO}/pulls`}>pull request</a>.
    </p>
  </div>
</Base>

<style>
  .hero {
    padding: 4.5rem 0 3rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 5rem);
    font-weight: 600;
    margin: 0;
  }

  .tagline {
    font-family: var(--display);
    font-variation-settings: 'opsz' 24;
    font-style: italic;
    font-size: clamp(1.05rem, 2.5vw, 1.25rem);
    color: var(--ink-soft);
    margin: 1.2rem auto 0;
    text-wrap: balance;
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc li + li {
    border-top: 1px solid var(--rule);
  }

  .toc a {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
    padding: 1.1rem 0.4rem;
    color: var(--ink);
    text-decoration: none;
  }

  .toc a:hover .chapter-title {
    color: var(--accent-ink);
  }

  .numeral {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40;
    font-style: italic;
    font-size: 1.15rem;
    color: var(--accent);
    min-width: 2em;
    text-align: right;
  }

  .chapter-title {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .colophon {
    margin-top: 3.5rem;
    text-align: center;
    font-size: 0.92rem;
    color: var(--faint);
    text-wrap: balance;
  }
</style>
