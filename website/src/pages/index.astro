---
import Base from '../layouts/Base.astro';
import { CHAPTERS, REPO, romanNumeral } from '../chapters';
---

<Base
  title="Principles — a collaborative project for approaching obstacles"
  description="Guiding principles, practical strategies, and the stories behind them — a living, forkable book about approaching life's obstacles."
>
  <section class="hero">
    <div class="wrap">
      <p class="overline">A living, forkable book</p>
      <h1>Principles</h1>
      <p class="tagline">
        A collaborative project for approaching obstacles — guiding principles,
        practical strategies, and the stories of how I got to them.
      </p>
      <div class="cta">
        <a class="button primary" href="/preface/">Start reading</a>
        <a class="button" href="#contents">Browse the contents</a>
      </div>
    </div>
  </section>

  <section class="parable">
    <div class="wrap-prose">
      <blockquote>
        <p>“Maybe… who knows if this is good or bad.”</p>
        <cite>— the farmer’s parable, from <a href="/life-principles/">Life Principles</a></cite>
      </blockquote>
    </div>
  </section>

  <section id="contents" class="contents">
    <div class="wrap">
      <p class="overline">Contents</p>
      <h2>Six chapters, so far</h2>
      <ol class="chapter-list">
        {
          CHAPTERS.map((chapter, i) => (
            <li>
              <a href={`/${chapter.id}/`}>
                <span class="numeral">{romanNumeral(i + 1)}</span>
                <span class="chapter-text">
                  <span class="chapter-title">{chapter.title}</span>
                  <span class="chapter-blurb">{chapter.blurb}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <div class="fleuron" aria-hidden="true">❦</div>

  <section class="about">
    <div class="wrap-prose">
      <p class="overline">Why “fork”?</p>
      <h2>Take what works. Leave the rest.</h2>
      <p>
        The title is borrowed, with respect, from Ray Dalio’s <em>Principles</em> —
        a book that encourages readers <em>not</em> to copy its author’s principles,
        but to discover their own. So this book is, in a sense, a fork: I kept what
        worked for me and rewrote the rest from my own life.
      </p>
      <p>
        I’d suggest you do the same. If most of these principles ring true, fork
        them — but instead of following them blindly, meditate on what’s actually
        important to you, and use mine only as a reference.
      </p>
    </div>
  </section>

  <section id="contribute" class="contribute">
    <div class="wrap-prose">
      <p class="overline">Contribute</p>
      <h2>This book is a conversation</h2>
      <p>
        Have a question, a correction, a better strategy, or a whole different set
        of obstacles? All are welcome.
      </p>
      <ul>
        <li>Email me at <a href="mailto:toli@tolicodes.com">toli@tolicodes.com</a></li>
        <li>Open an <a href={`${REPO}/issues`}>issue</a> with a question, suggestion, or idea</li>
        <li>Send a <a href={`${REPO}/pulls`}>pull request</a> — every page of this book is a markdown file</li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: 5rem 0 3rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(3.2rem, 9vw, 5.5rem);
    font-weight: 600;
    margin: 0.4rem 0 0;
  }

  .tagline {
    font-family: var(--display);
    font-variation-settings: 'opsz' 24;
    font-style: italic;
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    color: var(--ink-soft);
    max-width: 34em;
    margin: 1.2rem auto 0;
    text-wrap: balance;
  }

  .cta {
    margin-top: 2.2rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .button {
    display: inline-block;
    padding: 0.65rem 1.4rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--paper-raised);
    color: var(--ink);
    font-size: 0.95rem;
    text-decoration: none;
    box-shadow: var(--shadow);
    transition: transform 0.15s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper-raised);
  }

  .parable {
    padding: 2.5rem 0 1rem;
  }

  .parable blockquote {
    margin: 0;
    text-align: center;
    border: 0;
    font-family: var(--display);
    font-variation-settings: 'opsz' 40;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--ink-soft);
  }

  .parable cite {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--serif);
    font-style: normal;
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: var(--faint);
  }

  .contents {
    padding: 3.5rem 0 1rem;
  }

  .contents h2,
  .about h2,
  .contribute h2 {
    font-size: 1.9rem;
    margin: 0.3rem 0 1.6rem;
  }

  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(19rem, 1fr));
    gap: 1rem;
  }

  .chapter-list a {
    display: flex;
    gap: 1.1rem;
    height: 100%;
    padding: 1.3rem 1.4rem;
    background: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 12px;
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .chapter-list a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--rule));
  }

  .numeral {
    font-family: var(--display);
    font-variation-settings: 'opsz' 40;
    font-style: italic;
    font-size: 1.5rem;
    color: var(--accent);
    min-width: 1.7em;
    line-height: 1.3;
  }

  .chapter-text {
    display: block;
  }

  .chapter-title {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.12rem;
    margin-bottom: 0.35rem;
  }

  .chapter-blurb {
    display: block;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .about,
  .contribute {
    padding: 1.5rem 0;
  }

  .contribute li + li {
    margin-top: 0.4rem;
  }
</style>
